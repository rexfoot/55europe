rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin: Hicham (footrexofficial@gmail.com)
    function adminUid() { return 'tLbWtywFlBQ7zIUGMg3gbAGxdLZ2'; }
    function isAdmin() { return request.auth != null && request.auth.uid == adminUid(); }
    function me(uid) { return request.auth != null && request.auth.uid == uid; }
    function selfiePath(uid) { return /databases/$(database)/documents/selfies/$(uid); }
    function userData(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function validCar(c) {
      return c is map && c.keys().hasOnly(['brand','model','color'])
        && c.brand is string && c.brand.size() >= 2 && c.brand.size() <= 40
        && c.brand in ['Dacia','Renault','Peugeot','Citroën','Hyundai','Kia','Toyota','Volkswagen','Fiat','Ford','Skoda','Seat','Opel','Nissan','Suzuki','Mercedes-Benz','BMW','Audi','Chevrolet','Mitsubishi','Honda','Mazda','Chery','MG','Autre']
        && c.model is string && c.model.size() >= 1 && c.model.size() <= 40
        && c.color is string && c.color.size() >= 2 && c.color.size() <= 40;
    }
    function profileOk(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && exists(selfiePath(uid))
        && userData(uid).wa.matches('^[1-9][0-9]{7,14}$')
        && userData(uid).get('banned', false) == false
        && validCar(userData(uid).car); // v5: voiture obligatoire pour publier
    }

    function isValidTrip(d, uid) {
      return d.keys().hasOnly(['from','to','date','time','seats','price','ownerUid','createdAt'])
        && d.from is string && d.from.size() >= 2 && d.from.size() <= 60
        && d.to is string && d.to.size() >= 2 && d.to.size() <= 60
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.date >= '2026-01-01'
        && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$')
        && d.seats is int && d.seats >= 1 && d.seats <= 8
        && d.price is number && d.price > 0 && d.price <= 10000
        && d.ownerUid is string && d.ownerUid == uid
        && (!('createdAt' in d) || d.createdAt == request.time);
    }

    // ---- Perfiles: WhatsApp NO público, solo con sesión ----
    match /users/{uid} {
      // get con sesion (ver WhatsApp de un conductor); list solo admin (evita robar todos los numeros)
      // Para ver el WhatsApp de otro hay que tener selfie (pasajeros tambien)
      allow get: if me(uid) || isAdmin() || (request.auth != null && exists(selfiePath(request.auth.uid)));
      allow list: if isAdmin();
      allow create: if me(uid)
        && request.resource.data.keys().hasOnly(['nombre','foto','wa','banned','car','createdAt'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2
        && request.resource.data.wa is string && request.resource.data.wa.matches('^[1-9][0-9]{7,14}$')
        && request.resource.data.banned == false
        && (!('car' in request.resource.data) || validCar(request.resource.data.car))
        && (!('foto' in request.resource.data) || (request.resource.data.foto is string && request.resource.data.foto.size() <= 600))
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
      allow update: if (me(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre','foto','wa','car'])
          && request.resource.data.wa.matches('^[1-9][0-9]{7,14}$')
          && (!('car' in request.resource.data) || validCar(request.resource.data.car)))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned']));
      allow delete: if false;
    }

    // ---- Viajes: lectura pública, sin WhatsApp dentro ----
    match /trips/{tripId} {
      allow read: if true;
      allow create: if request.auth != null && profileOk(request.auth.uid)
        && isValidTrip(request.resource.data, request.auth.uid);
      allow update: if false; // nada se edita; el borrado va por delete
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // ---- Selfies: obligatorio, visible solo para usuarios conectados ----
    match /selfies/{uid} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create, update: if me(uid)
        && request.resource.data.keys().hasOnly(['img','createdAt'])
        && request.resource.data.img is string
        && request.resource.data.img.size() < 80000
        && request.resource.data.img.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
        && request.resource.data.createdAt == request.time;
      allow delete: if me(uid) || isAdmin();
    }

    // ---- Denuncias: una por usuario y viaje ----
    match /reports/{reportId} {
      allow read: if true; // para contar y ocultar con 3+
      allow create: if request.auth != null
        && reportId == request.resource.data.tripId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['tripId','uid','createdAt'])
        && request.resource.data.tripId is string
        && request.resource.data.uid == request.auth.uid
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
