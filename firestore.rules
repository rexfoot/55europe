rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function tripPath(id) { return /databases/$(database)/documents/trips/$(id); }
    function secretPath(id) { return /databases/$(database)/documents/secrets/$(id); }

    function isValidTrip(d) {
      return d.keys().hasOnly(['from','to','date','time','seats','price','wa','reports','createdAt'])
        && d.keys().hasAll(['from','to','date','time','seats','price','wa','reports'])
        && d.from is string && d.from.size() >= 2 && d.from.size() <= 60
        && d.to is string && d.to.size() >= 2 && d.to.size() <= 60
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.date >= '2026-01-01'
        && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$')
        && d.seats is int && d.seats >= 1 && d.seats <= 8
        && d.price is number && d.price > 0 && d.price <= 10000
        && d.wa is string && d.wa.matches('^212[0-9]{9}$')
        && d.reports == 0
        && (!('createdAt' in d) || d.createdAt == request.time);
    }

    match /trips/{tripId} {
      allow read: if true;
      // El viaje y su secreto se crean juntos en el mismo writeBatch.
      allow create: if isValidTrip(request.resource.data)
        && existsAfter(secretPath(tripId));
      // Solo cambian deleteCode (peticion de borrado) o reports (+1 por denuncia).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleteCode','reports'])
        && (
          request.resource.data.reports == resource.data.get('reports', 0)
          || request.resource.data.reports == resource.data.get('reports', 0) + 1
        )
        && (!('deleteCode' in request.resource.data) || (request.resource.data.deleteCode is string && request.resource.data.deleteCode.size() <= 64));
      // Borrado solo si deleteCode coincide con secrets/{tripId}.code
      allow delete: if exists(secretPath(tripId))
        && resource.data.get('deleteCode', '') == get(secretPath(tripId)).data.code;
    }

    match /secrets/{tripId} {
      allow read: if false;
      // Solo se puede crear junto con un viaje NUEVO (mismo batch): nadie puede adueñarse de un viaje ajeno.
      allow create: if request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 4 && request.resource.data.code.size() <= 64
        && !exists(tripPath(tripId))
        && existsAfter(tripPath(tripId));
      allow update, delete: if false;
    }
  }
}
