rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin: Hicham (footrexofficial@gmail.com)
    function adminUid() { return 'tLbWtywFlBQ7zIUGMg3gbAGxdLZ2'; }
    function isAdmin() { return request.auth != null && request.auth.uid == adminUid(); }
    function me(uid) { return request.auth != null && request.auth.uid == uid; }
    function selfiePath(uid) { return /databases/$(database)/documents/selfies/$(uid); }
    function userData(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function phoneOf(uid) { return get(/databases/$(database)/documents/phones/$(uid)).data.wa; }
    function hasPhone(uid) {
      return exists(/databases/$(database)/documents/phones/$(uid))
        && phoneOf(uid).matches('^[1-9][0-9]{7,14}$');
    }
    function notBanned(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && userData(uid).get('banned', false) == false;
    }
    function hasSelfie(uid) { return exists(selfiePath(uid)); }
    function motoVeh(c) {
      return (('type' in c) && c.type == 'moto') || (('category' in c) && c.category == 'moto');
    }
    function validCar(c) {
      return c is map && c.keys().hasOnly(['type','brand','model','color','category'])
        && (!('type' in c) || c.type in ['car','moto'])
        && c.brand is string && c.brand.size() >= 2 && c.brand.size() <= 40
        && c.model is string && c.model.size() >= 1 && c.model.size() <= 40
        && c.color is string && c.color.size() >= 2 && c.color.size() <= 40
        && ((motoVeh(c) && c.category == 'moto'
          && c.brand in ['Yamaha','Honda','Suzuki','Kymco','SYM','Peugeot','Piaggio/Vespa','Docker','Benelli','Autre'])
        || (!motoVeh(c) && c.category in ['citadine','berline','suv','7places','luxe']
          && c.brand in ['Dacia','Renault','Peugeot','Citroën','Hyundai','Kia','Toyota','Volkswagen','Fiat','Ford','Skoda','Seat','Opel','Nissan','Suzuki','Mercedes-Benz','BMW','Audi','Chevrolet','Mitsubishi','Honda','Mazda','Chery','MG','Autre']));
    }
    // Profil complet conducteur : selfie + tel + pas banni + voiture
    function profileOk(uid) {
      return notBanned(uid) && hasSelfie(uid) && hasPhone(uid)
        && validCar(userData(uid).car);
    }
    // Profil passager : pas besoin de voiture
    function profileOkLight(uid) {
      return notBanned(uid) && hasSelfie(uid) && hasPhone(uid);
    }
    // Profil motard : selfie + tel + pas banni + moto
    function profileOkMoto(uid) {
      return notBanned(uid) && hasSelfie(uid) && hasPhone(uid)
        && motoVeh(userData(uid).car) && validCar(userData(uid).car);
    }

    function basePost(d, uid) {
      return d.from is string && d.from.size() >= 2 && d.from.size() <= 60
        && d.to is string && d.to.size() >= 2 && d.to.size() <= 60
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.date >= '2026-01-01'
        && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$')
        && d.seats is int && d.seats >= 1 && d.seats <= 8
        && d.price is number && d.price > 0 && d.price <= 10000
        && d.ownerUid is string && d.ownerUid == uid
        && (!('createdAt' in d) || d.createdAt == request.time);
    }
    function isValidTrip(d, uid) {
      return d.keys().hasOnly(['from','to','fromKey','toKey','scope','vkind','date','time','seats','price','ownerUid','createdAt'])
        && d.fromKey is string && d.fromKey.size() >= 1 && d.fromKey.size() <= 60
        && d.toKey is string && d.toKey.size() >= 1 && d.toKey.size() <= 60
        && (!('scope' in d) || d.scope in ['city','intercity'])
        && (!('vkind' in d) || d.vkind in ['car','moto'])
        && (!('vkind' in d) || d.vkind != 'moto' || d.seats == 1)
        && basePost(d, uid);
    }
    function isValidRequest(d, uid) {
      return d.keys().hasOnly(['from','to','fromKey','toKey','scope','wanted','date','time','seats','price','msg','ownerUid','createdAt'])
        && d.fromKey is string && d.fromKey.size() >= 1 && d.fromKey.size() <= 60
        && d.toKey is string && d.toKey.size() >= 1 && d.toKey.size() <= 60
        && (!('scope' in d) || d.scope in ['city','intercity'])
        && (!('wanted' in d) || d.wanted in ['car','moto','any'])
        && basePost(d, uid)
        && (!('msg' in d) || (d.msg is string && d.msg.size() <= 200));
    }

    // ---- Profils (sans numéro ; voir phones) ----
    match /users/{uid} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if me(uid)
        && request.resource.data.keys().hasOnly(['nombre','foto','banned','car','createdAt'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2
        && request.resource.data.banned == false
        && (!('car' in request.resource.data) || validCar(request.resource.data.car))
        && (!('foto' in request.resource.data) || (request.resource.data.foto is string && request.resource.data.foto.size() <= 600))
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
      allow update: if (me(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre','foto','wa','car'])
          && !('wa' in request.resource.data) // migration : suppression définitive de users.wa
          && (!('car' in request.resource.data) || validCar(request.resource.data.car)))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned']));
      allow delete: if false;
    }

    // ---- Numéros WhatsApp privés ----
    match /phones/{uid} {
      // Visible : propriétaire, admin, ou contact accepté (link dans un sens ou l'autre)
      allow get: if me(uid) || isAdmin()
        || (request.auth != null && (exists(/databases/$(database)/documents/links/$(request.auth.uid + '_' + uid))
          || exists(/databases/$(database)/documents/links/$(uid + '_' + request.auth.uid))));
      allow list: if false;
      allow create, update: if me(uid)
        && request.resource.data.keys().hasOnly(['wa'])
        && request.resource.data.wa is string && request.resource.data.wa.matches('^[1-9][0-9]{7,14}$');
      allow delete: if false;
    }

    // ---- Trajets proposés (conducteurs) : lecture publique, sans contact direct ----
    match /trips/{tripId} {
      allow read: if true;
      allow create: if request.auth != null
        && isValidTrip(request.resource.data, request.auth.uid)
        && ((request.resource.data.get('vkind', 'car') == 'moto' && profileOkMoto(request.auth.uid))
          || (request.resource.data.get('vkind', 'car') == 'car' && profileOk(request.auth.uid) && !motoVeh(userData(request.auth.uid).car)));
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // ---- Demandes de passagers : pas de voiture exigée ----
    match /requests/{reqId} {
      allow read: if true;
      allow create: if request.auth != null && profileOkLight(request.auth.uid)
        && isValidRequest(request.resource.data, request.auth.uid);
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // ---- Selfies : obligatoire, visible solo para usuarios conectados ----
    match /selfies/{uid} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create, update: if me(uid)
        && request.resource.data.keys().hasOnly(['img','createdAt'])
        && request.resource.data.img is string
        && request.resource.data.img.size() < 80000
        && request.resource.data.img.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
        && request.resource.data.createdAt == request.time;
      allow delete: if me(uid) || isAdmin();
    }

    // ---- Contacts privés : « Je suis intéressé » ----
    match /contacts/{cid} {
      allow read: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.fromUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && cid == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['postId','postType','ownerUid','fromUid','message','price','status','createdAt'])
        && request.resource.data.postType in ['trip','request']
        && request.resource.data.postId is string
        && request.resource.data.ownerUid is string && request.resource.data.ownerUid != request.auth.uid
        // Claude: el ownerUid debe ser el autor real del anuncio
        && ((request.resource.data.postType == 'trip' && get(/databases/$(database)/documents/trips/$(request.resource.data.postId)).data.ownerUid == request.resource.data.ownerUid)
          || (request.resource.data.postType == 'request' && get(/databases/$(database)/documents/requests/$(request.resource.data.postId)).data.ownerUid == request.resource.data.ownerUid))
        && hasSelfie(request.auth.uid) && hasPhone(request.auth.uid) && notBanned(request.auth.uid)
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.message is string && request.resource.data.message.size() <= 200
        && (!('price' in request.resource.data) || (request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.price <= 10000))
        && request.resource.data.status == 'pending'
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
      // Seul le propriétaire accepte/refuse ; si accepté, le link mutuel doit exister après (même batch)
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted','refused']
        && (request.resource.data.status == 'refused'
          || existsAfter(/databases/$(database)/documents/links/$(resource.data.ownerUid + '_' + resource.data.fromUid)));
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.fromUid == request.auth.uid && resource.data.status == 'pending');
    }

    // ---- Liens mutuels créés à l'acceptation (débloquent les numéros) ----
    match /links/{lid} {
      allow read: if request.auth != null
        && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['a','b','postId','createdAt'])
        && request.resource.data.a is string && request.resource.data.b is string
        && request.resource.data.postId is string
        && request.resource.data.a == request.auth.uid
        && lid == request.resource.data.a + '_' + request.resource.data.b   // Claude: el id DEBE ser a_b (si no, se podria leer el telefono de cualquiera)
        && ((existsAfter(/databases/$(database)/documents/contacts/$(request.resource.data.postId + '_' + request.resource.data.b))
          && getAfter(/databases/$(database)/documents/contacts/$(request.resource.data.postId + '_' + request.resource.data.b)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/contacts/$(request.resource.data.postId + '_' + request.resource.data.b)).data.ownerUid == request.resource.data.a)
        || (existsAfter(/databases/$(database)/documents/rides/$(request.resource.data.postId))
          && getAfter(/databases/$(database)/documents/rides/$(request.resource.data.postId)).data.status == 'matched'
          && getAfter(/databases/$(database)/documents/rides/$(request.resource.data.postId)).data.ownerUid == request.resource.data.a
          && getAfter(/databases/$(database)/documents/rides/$(request.resource.data.postId)).data.driverUid == request.resource.data.b));
      allow update, delete: if false;
    }

    // ---- Moto ahora : courses immédiates ----
    function isValidRide(d, uid) {
      return d.keys().hasOnly(['ownerUid','city','cityKey','fromLabel','toLabel','fromLat','fromLng','toLat','toLng','price','comment','status','targetDriver','targetUntil','tried','createdAt','expiresAt'])
        && d.ownerUid is string && d.ownerUid == uid
        && d.city is string && d.city.size() >= 2 && d.city.size() <= 60
        && d.cityKey is string && d.cityKey.size() >= 1 && d.cityKey.size() <= 60
        && d.fromLabel is string && d.fromLabel.size() >= 2 && d.fromLabel.size() <= 80
        && (!('toLabel' in d) || (d.toLabel is string && d.toLabel.size() <= 80))
        && (!('fromLat' in d) || (d.fromLat is number && d.fromLat >= -90 && d.fromLat <= 90))
        && (!('fromLng' in d) || (d.fromLng is number && d.fromLng >= -180 && d.fromLng <= 180))
        && (!('toLat' in d) || (d.toLat is number && d.toLat >= -90 && d.toLat <= 90))
        && (!('toLng' in d) || (d.toLng is number && d.toLng >= -180 && d.toLng <= 180))
        && d.price is number && d.price >= 5 && d.price <= 500
        && (!('comment' in d) || (d.comment is string && d.comment.size() <= 120))
        && d.status == 'open'
        && !('driverUid' in d)
        && d.createdAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt > request.time + duration.value(10, 'm')
        && d.expiresAt < request.time + duration.value(20, 'm');
    }
    match /rides/{rideId} {
      allow read: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || resource.data.get('driverUid', '') == request.auth.uid
          || isAdmin() || profileOkMoto(request.auth.uid)); /* Claude: el GPS del pasajero solo lo ven motoristas verificados */ // sin teléfonos dentro
      allow create: if request.auth != null
        && notBanned(request.auth.uid) && hasSelfie(request.auth.uid) && hasPhone(request.auth.uid)
        && isValidRide(request.resource.data, request.auth.uid);
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price'])
            && resource.data.status == 'open' && resource.data.expiresAt > request.time
            && request.resource.data.price > resource.data.price && request.resource.data.price <= 500)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled')
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','driverUid'])
            && resource.data.status == 'open'
            && request.resource.data.status == 'matched'
            && exists(/databases/$(database)/documents/rides/$(rideId)/offers/$(request.resource.data.driverUid))
            && existsAfter(/databases/$(database)/documents/links/$(resource.data.ownerUid + '_' + request.resource.data.driverUid)))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['targetDriver','targetUntil','tried'])
              && resource.data.status == 'open' && resource.data.expiresAt > request.time
              && (!('targetDriver' in request.resource.data) || (
                exists(/databases/$(database)/documents/drivers/$(request.resource.data.targetDriver))
                && get(/databases/$(database)/documents/drivers/$(request.resource.data.targetDriver)).data.online == true))
              && (!('targetUntil' in request.resource.data) || (request.resource.data.targetUntil is timestamp
                && request.resource.data.targetUntil > request.time
                && request.resource.data.targetUntil < request.time + duration.value(60, 's')))
              && (!('tried' in request.resource.data) || (request.resource.data.tried is list
                && request.resource.data.tried.size() <= 10))));
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }
    match /rides/{rideId}/offers/{driverUid} {
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/rides/$(rideId)).data.ownerUid == request.auth.uid
          || driverUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && driverUid == request.auth.uid
        && profileOkMoto(request.auth.uid)
        && get(/databases/$(database)/documents/rides/$(rideId)).data.status == 'open'
        && get(/databases/$(database)/documents/rides/$(rideId)).data.expiresAt > request.time
        && get(/databases/$(database)/documents/rides/$(rideId)).data.ownerUid != request.auth.uid
        && request.resource.data.keys().hasOnly(['driverUid','price','eta','createdAt'])
        && request.resource.data.driverUid == request.auth.uid
        && request.resource.data.price is number && request.resource.data.price >= 5 && request.resource.data.price <= 500
        && request.resource.data.eta is int && request.resource.data.eta >= 1 && request.resource.data.eta <= 60
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
      allow update: if request.auth != null && driverUid == request.auth.uid
        && get(/databases/$(database)/documents/rides/$(rideId)).data.status == 'open'
        && get(/databases/$(database)/documents/rides/$(rideId)).data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price','eta'])
        && request.resource.data.price is number && request.resource.data.price >= 5 && request.resource.data.price <= 500
        && request.resource.data.eta is int && request.resource.data.eta >= 1 && request.resource.data.eta <= 60;
      allow delete: if false;
    }
    // ---- Position des motoristas en ligne (arrondie ~100 m côté client) ----
    match /drivers/{uid} {
      allow read: if request.auth != null && hasSelfie(request.auth.uid);
      allow create, update: if me(uid) && profileOkMoto(uid)
        && request.resource.data.keys().hasOnly(['lat','lng','cityKey','online','updatedAt'])
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.cityKey is string && request.resource.data.cityKey.size() >= 1 && request.resource.data.cityKey.size() <= 60
        && request.resource.data.online is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // ---- Chat passager <-> motorista por oferta ----
    match /rides/{rideId}/chats/{driverUid}/messages/{msgId} {
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/rides/$(rideId)).data.ownerUid == request.auth.uid
          || driverUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && (get(/databases/$(database)/documents/rides/$(rideId)).data.ownerUid == request.auth.uid
          || driverUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['from','text','createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
        && !request.resource.data.text.matches('(?s).*([0-9]{8,}|0[5-7]([ .-]?[0-9]){8}|[+]?212[ .-]?[5-7]).*') /* Claude: sin números de teléfono en el chat */
        && exists(/databases/$(database)/documents/rides/$(rideId)/offers/$(driverUid)) /* Claude: solo motoristas que han hecho oferta */
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /rides/{rideId}/declines/{driverUid} {
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/rides/$(rideId)).data.ownerUid == request.auth.uid
          || driverUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && driverUid == request.auth.uid
        && profileOkMoto(request.auth.uid)
        && request.resource.data.keys().hasOnly(['driverUid','createdAt'])
        && request.resource.data.driverUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // ---- Notes après course : les 2 participants, une fois chacun ----
    match /ratings/{rid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && rid == request.resource.data.rideId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['rideId','from','to','stars','createdAt'])
        && request.resource.data.rideId is string
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
        && get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.status == 'matched'
        && (get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.ownerUid == request.auth.uid
          || get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.driverUid == request.auth.uid)
        && (get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.ownerUid == request.resource.data.to
          || get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.driverUid == request.resource.data.to);
      allow update, delete: if false;
    }

    // ---- Denuncias : una por usuario y anuncio (trips o requests) ----
    match /reports/{reportId} {
      allow read: if true;
      allow create: if request.auth != null
        && reportId == request.resource.data.tripId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['tripId','uid','createdAt'])
        && request.resource.data.tripId is string
        && request.resource.data.uid == request.auth.uid
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
